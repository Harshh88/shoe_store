          <LogoMain className={""} />
          <SearchBar className={"w-[45%] h-[3rem] "} />
        </div>
        <div className="flex items-center gap-[2rem] w-[25%]">
          <NavBar
            links={[
              { label: "Shops", href: "/shops" },
              { label: "Products", href: "/products" },
            ]}
            className="w-full max-w-md"
          />
        </div>
      </div>
      <HomeCard />
