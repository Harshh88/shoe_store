    { name: "Carbon Collective", location: "Chicago, IL", tag: "Art District", image: "https://images.unsplash.com/photo-1512436991641-6745cdb1723f?w=800" },
    { name: "Carbon Collective", location: "Chicago, IL", tag: "Art District", image: "https://images.unsplash.com/photo-1512436991641-6745cdb1723f?w=800" },
    { name: "Carbon Collective", location: "Chicago, IL", tag: "Art District", image: "https://images.unsplash.com/photo-1512436991641-6745cdb1723f?w=800" },
    { name: "Carbon Collective", location: "Chicago, IL", tag: "Art District", image: "https://images.unsplash.com/photo-1512436991641-6745cdb1723f?w=800" },
